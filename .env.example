# Copy to `.env` and fill in. `.env` is git-ignored: never commit real keys.
# Values: Supabase dashboard > Project Settings > API Keys (or `npx supabase projects api-keys`).

# --- Frontend (public, embedded in the website) ---------------------------
# Safe to expose: without a logged-in member the database policies allow nothing.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Maintenance scripts only (PRIVATE, never put in the frontend) --------
# Used by `npm run create-admin`, `npm run import`, `npm run export`.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional: shown in the credentials printed by the scripts.
SITE_URL=https://<github-user>.github.io/grusf-wiki/
