{
	"name": "grusf-wiki",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "supabase db push --linked",
		"functions:deploy": "supabase functions deploy --use-api",
		"config:push": "supabase config push",
		"deploy:backend": "npm run db:push && npm run functions:deploy",
		"create-admin": "node scripts/create-admin.ts",
		"import": "node scripts/import-dokuwiki.ts",
		"import:sample": "node scripts/import-dokuwiki.ts sample-data/dokuwiki",
		"export": "node scripts/export-dokuwiki.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"bcryptjs": "^3.0.3",
		"dotenv": "^18.0.9",
		"supabase": "^2.122.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.118.0"
	},
	"engines": {
		"node": ">=22.18"
	}
}
